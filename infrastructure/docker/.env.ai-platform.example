# Copy this file to .env.ai-platform. Never commit the real file.
# Upstream provider key used only by LiteLLM.
OPENAI_API_KEY=replace-with-provider-api-key

# Local FlowPilot PostgreSQL password (for the pgvector database service).
APP_DB_PASSWORD=replace-with-a-long-random-password

# Gateway administration secrets. Generate long random values.
LITELLM_MASTER_KEY=sk-change-this-to-a-long-random-secret
LITELLM_SALT_KEY=replace-with-a-different-long-random-secret
LITELLM_DB_PASSWORD=replace-with-a-long-random-password

# Generate a least-privilege virtual key via the LiteLLM key-management API.
# This is for Open WebUI only; generate a separate key for the FlowPilot backend.
LITELLM_WEBUI_KEY=sk-create-a-scoped-virtual-key
