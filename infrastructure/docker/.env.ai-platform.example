# Copy to .env.ai-platform. Never commit the real file.
# Provider key used only by the LiteLLM container.
OPENAI_API_KEY=replace-with-provider-api-key
# Local LiteLLM key/spend database (the postgres service in docker-compose).
DATABASE_URL=postgresql://app:app@postgres:5432/process_automation

# Admin key for LiteLLM key generation and administration. Keep it private.
LITELLM_MASTER_KEY=sk-change-this-to-a-long-random-secret
# Keep this encryption key stable after saving provider credentials in LiteLLM.
LITELLM_SALT_KEY=sk-generate-another-long-random-secret

# Generate a separate least-privilege virtual key for OpenWebUI.
LITELLM_WEBUI_KEY=sk-create-a-scoped-virtual-key

# Generate a separate least-privilege virtual key for the FlowPilot backend.
# It should be allowed to call process-analysis, process-vision and process-embeddings.
LITELLM_BACKEND_KEY=sk-create-a-scoped-backend-key
