# Copy to .env.ai-platform. Never commit the real file.
# Provider key used only by the LiteLLM container.
OPENAI_API_KEY=replace-with-provider-api-key

# Admin key for LiteLLM key generation and administration. Keep it private.
LITELLM_MASTER_KEY=sk-change-this-to-a-long-random-secret

# Generate a separate least-privilege virtual key for OpenWebUI.
LITELLM_WEBUI_KEY=sk-create-a-scoped-virtual-key
