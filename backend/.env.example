APP_NAME=AI Process Automation Engine
DATABASE_URL=sqlite:///./process_automation.db
# Optional: only set this on a Render PR preview when using a separate preview datastore.
PREVIEW_DATABASE_URL=
OPENAI_API_KEY=
# Optional: Render PR previews ignore OPENAI_API_KEY and use this preview-only key.
PREVIEW_OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Optional OpenAI-compatible gateway URL, e.g. http://localhost:4000/v1 for LiteLLM.
# When using a gateway, OPENAI_API_KEY must be a least-privilege gateway virtual key.
OPENAI_BASE_URL=
PREVIEW_OPENAI_BASE_URL=
# Optional companion OpenWebUI portal URL displayed in Step 6.
OPENWEBUI_URL=
PREVIEW_OPENWEBUI_URL=
# Optional: set these to the current provider prices, in USD per 1 million tokens.
# Leave blank until verified for the selected model; costs will remain unavailable.
OPENAI_INPUT_USD_PER_1M=
OPENAI_OUTPUT_USD_PER_1M=
CORS_ORIGINS=http://localhost:4200,https://your-frontend-domain.example

# Live webhook execution is deliberately disabled until an administrator opts in.
# The operator token is requested in the UI and is never sent to the receiver.
WEBHOOK_EXECUTION_ENABLED=false
WORKFLOW_WEBHOOK_URL=
WORKFLOW_WEBHOOK_BEARER_TOKEN=
WORKFLOW_LIVE_EXECUTION_TOKEN=
WORKFLOW_WEBHOOK_TIMEOUT_SECONDS=10

# OpenAI-compatible LiteLLM model aliases for vision and embeddings.
OPENAI_VISION_MODEL=process-vision
OPENAI_EMBEDDING_MODEL=process-embeddings
EMBEDDING_DIMENSIONS=1536
# Leave disabled on public demos until authentication and document ACLs are available.
KNOWLEDGE_PERSISTENCE_ENABLED=false
PREVIEW_KNOWLEDGE_PERSISTENCE_ENABLED=false
